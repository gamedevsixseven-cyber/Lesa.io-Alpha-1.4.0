rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // AUTHENTICATION & DEVELOPER AUTHORIZATION HELPERS
    // ONLY the Primary Developer account has Dev/Admin authority.
    // =========================================================================
    function isPrimaryDev() {
      return request.auth != null
        && request.auth.uid == 'RLqBTfjZATZzePCPDyNCrUGCYrs2'
        && (request.auth.token.email == null
            || (request.auth.token.email_verified == true
                && request.auth.token.email.lower() == 'gamedevsixseven@gmail.com'));
    }

    function isSignedInOwner(ownerUid) {
      return request.auth != null && request.auth.uid == ownerUid;
    }

    // Device guest IDs generated by PlayerIdentity / NameValidator (no Firebase Auth)
    function isGuestProfileId(id) {
      return id is string && id.matches('^(phone|player|user|playtest)_[a-zA-Z0-9_]{4,80}$');
    }

    function isNonNegNum(val, maxVal) {
      return !((val is int || val is float)) || (val >= 0 && val <= maxVal);
    }

    function isValidPlayerPayload(data, playerId) {
      return data.keys().size() <= 120
        && (!('uid' in data) || data.uid == null || (data.uid is string && data.uid == playerId))
        && (!('playerName' in data) || data.playerName == null || (data.playerName is string && data.playerName.size() <= 40))
        && (!('friendTag' in data) || data.friendTag == null || (data.friendTag is string && data.friendTag.size() <= 16))
        && (!('coins' in data) || isNonNegNum(data.coins, 1000000000))
        && (!('gold' in data) || isNonNegNum(data.gold, 1000000000))
        && (!('gems' in data) || isNonNegNum(data.gems, 1000000000))
        && (!('diamonds' in data) || isNonNegNum(data.diamonds, 1000000000))
        && (!('lbHighScore' in data) || isNonNegNum(data.lbHighScore, 2000000000))
        && (!('lbEndlessWave' in data) || isNonNegNum(data.lbEndlessWave, 9999))
        && (!('lbTotalKills' in data) || isNonNegNum(data.lbTotalKills, 50000000));
    }

    // =========================================================================
    // 1. DEVELOPER & INTERNAL CONFIG COLLECTIONS (PRIMARY DEV ONLY)
    // =========================================================================
    match /admins/{docId} {
      allow read, write: if isPrimaryDev();
    }

    match /config/{docId} {
      allow read, write: if isPrimaryDev();
    }

    // =========================================================================
    // 2. PLAYER SAVES, PRESENCE & LEADERBOARDS
    // - Public read for Leaderboards, Friend Search & Public Profiles
    // - Google-linked accounts (including Primary Dev) are strictly owner-only
    // - Guest device IDs cannot spoof emails, UIDs, or admin flags
    // - ONLY Primary Dev can delete accounts or modify protected dev/admin flags
    // =========================================================================
    match /players/{playerId} {
      allow read: if true;

      allow create: if isPrimaryDev() || (
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
        && !('wipedByDevAt' in request.resource.data)
        && isValidPlayerPayload(request.resource.data, playerId)
        && (
          isSignedInOwner(playerId)
          || (
            isGuestProfileId(playerId)
            && !('email' in request.resource.data)
          )
        )
      );

      allow update: if isPrimaryDev() || (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isAdmin', 'uid', 'email', 'wipedByDevAt'
        ])
        && isValidPlayerPayload(request.resource.data, playerId)
        && (
          isSignedInOwner(playerId)
          || (
            isGuestProfileId(playerId)
            && resource.data.get('isAdmin', false) == false
            && !('email' in resource.data)
          )
        )
      );

      allow delete: if isPrimaryDev();
    }

    // =========================================================================
    // 3. UNIQUE PLAYER NAMES REGISTRY
    // - Prevents anyone from hijacking Dev or Google-owned usernames
    // - ONLY Primary Dev can delete username docs
    // =========================================================================
    match /usernames/{nameId} {
      allow read: if true;

      allow create: if isPrimaryDev() || (
        nameId.size() >= 1 && nameId.size() <= 32
        && request.resource.data.uid is string
        && request.resource.data.nameLower is string
        && request.resource.data.nameLower == nameId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 32
        && (
          isSignedInOwner(request.resource.data.uid)
          || isGuestProfileId(request.resource.data.uid)
        )
      );

      allow update: if isPrimaryDev() || (
        nameId.size() >= 1 && nameId.size() <= 32
        && (
          // Unclaimed / previously released name can be claimed cleanly
          (
            (!('uid' in resource.data) || resource.data.uid == '' || resource.data.get('released', false) == true)
            && request.resource.data.uid is string
            && request.resource.data.uid != ''
            && request.resource.data.nameLower == nameId
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() >= 1
            && request.resource.data.displayName.size() <= 32
            && (isSignedInOwner(request.resource.data.uid) || isGuestProfileId(request.resource.data.uid))
          )
          // Owned name: Google owners verified strictly by Auth; guest owners cannot touch non-guest names or transfer to Auth UIDs
          || (
            'uid' in resource.data && resource.data.uid != ''
            && (
              isSignedInOwner(resource.data.uid)
              || isGuestProfileId(resource.data.uid)
            )
            && (
              !('uid' in request.resource.data)
              || request.resource.data.uid == ''
              || isSignedInOwner(request.resource.data.uid)
              || isGuestProfileId(request.resource.data.uid)
            )
          )
        )
      );

      allow delete: if isPrimaryDev();
    }

    // =========================================================================
    // 4. MUTUAL FRIENDSHIPS & PENDING REQUESTS
    // - Doc ID must equal sorted uidA__uidB
    // - Authenticated accounts cannot be impersonated as requester
    // =========================================================================
    match /friendships/{relId} {
      allow read: if true;

      allow create: if isPrimaryDev() || (
        request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] is string
        && request.resource.data.users[1] is string
        && request.resource.data.users[0] < request.resource.data.users[1]
        && relId == request.resource.data.users[0] + '__' + request.resource.data.users[1]
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedBy is string
        && request.resource.data.requestedBy in request.resource.data.users
        && (
          isSignedInOwner(request.resource.data.requestedBy)
          || isGuestProfileId(request.resource.data.requestedBy)
        )
      );

      allow update: if isPrimaryDev() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'acceptedAt', 'updatedAt', 'profiles'
        ])
        && request.resource.data.status == 'accepted'
        && (
          isGuestProfileId(resource.data.users[0])
          || isGuestProfileId(resource.data.users[1])
          || (request.auth != null && request.auth.uid in resource.data.users)
        )
      );

      allow delete: if isPrimaryDev() || (
        resource != null
        && (
          isGuestProfileId(resource.data.users[0])
          || isGuestProfileId(resource.data.users[1])
          || (request.auth != null && request.auth.uid in resource.data.users)
        )
      );

      // Direct Messages subcollection between accepted friends
      match /messages/{msgId} {
        allow read: if true;

        allow create: if isPrimaryDev() || (
          exists(/databases/$(database)/documents/friendships/$(relId))
          && get(/databases/$(database)/documents/friendships/$(relId)).data.status == 'accepted'
          && request.resource.data.keys().hasAll(['senderUid', 'senderName', 'text', 'createdAt'])
          && request.resource.data.keys().size() <= 8
          && request.resource.data.senderUid is string
          && request.resource.data.senderUid in get(/databases/$(database)/documents/friendships/$(relId)).data.users
          && (
            isSignedInOwner(request.resource.data.senderUid)
            || isGuestProfileId(request.resource.data.senderUid)
          )
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() >= 1
          && request.resource.data.senderName.size() <= 40
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 240
          && request.resource.data.createdAt is int
          && request.resource.data.createdAt > 0
        );

        allow update, delete: if isPrimaryDev();
      }
    }

    // =========================================================================
    // 5. LIVE CO-OP ROOM INVITATIONS
    // - Prevents sending fake Co-op invites from Dev or Google accounts
    // =========================================================================
    match /friend_invites/{inviteId} {
      allow read: if true;

      allow create, update: if isPrimaryDev() || (
        request.resource.data.fromUid is string
        && request.resource.data.toUid is string
        && request.resource.data.fromUid != request.resource.data.toUid
        && inviteId == request.resource.data.fromUid + '__' + request.resource.data.toUid
        && request.resource.data.roomCode is string
        && request.resource.data.roomCode.size() >= 3
        && request.resource.data.roomCode.size() <= 32
        && (
          isSignedInOwner(request.resource.data.fromUid)
          || isGuestProfileId(request.resource.data.fromUid)
        )
      );

      allow delete: if isPrimaryDev() || (
        resource != null
        && (
          isGuestProfileId(resource.data.fromUid)
          || isGuestProfileId(resource.data.toUid)
          || isSignedInOwner(resource.data.fromUid)
          || isSignedInOwner(resource.data.toUid)
        )
      );
    }

    // =========================================================================
    // 6. CLANS, TAX VAULT, SHARED WEEKLY BOUNTIES & CLAN CHAT
    // - Protects immutable Clan ID/Tag/Name and Google-linked Leaders
    // - Allows Tax Vault donations, Weekly Bounties, Role Promotions & Live Chat
    // =========================================================================
    match /clans/{clanId} {
      allow read: if true;

      allow create: if isPrimaryDev() || (
        request.resource.data.keys().size() <= 24
        && request.resource.data.id == clanId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 20
        && request.resource.data.tag is string
        && request.resource.data.tag.size() >= 3
        && request.resource.data.tag.size() <= 4
        && request.resource.data.leaderUid is string
        && (
          isSignedInOwner(request.resource.data.leaderUid)
          || isGuestProfileId(request.resource.data.leaderUid)
        )
        && request.resource.data.members is map
        && request.resource.data.leaderUid in request.resource.data.members
        && isNonNegNum(request.resource.data.xp, 100000000)
      );

      allow update: if isPrimaryDev() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'members', 'memberCount', 'joinRequests', 'activityLog', 'leaderUid',
          'motto', 'vault', 'xp', 'level', 'bounties', 'claimedXpKeys'
        ])
        && isNonNegNum(request.resource.data.xp, 100000000)
        && isNonNegNum(request.resource.data.level, 50)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['leaderUid'])
          || isSignedInOwner(resource.data.leaderUid)
          || isGuestProfileId(resource.data.leaderUid)
        )
      );

      allow delete: if isPrimaryDev() || (
        resource != null
        && resource.data.memberCount <= 1
        && (
          isSignedInOwner(resource.data.leaderUid)
          || isGuestProfileId(resource.data.leaderUid)
        )
      );

      // Clan Guild Hall Chat subcollection (members only)
      match /messages/{msgId} {
        allow read: if true;

        allow create: if isPrimaryDev() || (
          exists(/databases/$(database)/documents/clans/$(clanId))
          && request.resource.data.keys().hasAll(['senderUid', 'senderName', 'text', 'createdAt'])
          && request.resource.data.keys().size() <= 10
          && request.resource.data.senderUid is string
          && request.resource.data.senderUid in get(/databases/$(database)/documents/clans/$(clanId)).data.members
          && (
            isSignedInOwner(request.resource.data.senderUid)
            || isGuestProfileId(request.resource.data.senderUid)
          )
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() >= 1
          && request.resource.data.senderName.size() <= 40
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 240
          && request.resource.data.createdAt is int
          && request.resource.data.createdAt > 0
          && (!('senderLevel' in request.resource.data) || (request.resource.data.senderLevel is int && request.resource.data.senderLevel >= 1 && request.resource.data.senderLevel <= 999))
          && (!('senderRole' in request.resource.data) || request.resource.data.senderRole in ['leader', 'co_leader', 'officer', 'member'])
        );

        allow update, delete: if isPrimaryDev();
      }
    }

    // =========================================================================
    // 7. DEFAULT DENY CATCH-ALL
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
